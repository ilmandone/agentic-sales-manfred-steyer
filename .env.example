# Environment of the agent (npm run agent). Copy to .env and fill in.
# Base URL of the aggregation server (npm run server in the repo root)
# AGG_SERVER_URL=http://localhost:3000

# Model provider: ollama (default) or cloudflare
MODEL_PROVIDER=ollama
# false by default
MODEL_THINKING=
MODEL_TEMPERATURE=0

# Ollama with Gemma 4, e.g. on a GPU server
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:26b-a4b-it-q8_0

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# What runQuery returns to the model: model_decides (default), full or minimal
RETURN_TOOL_RESULT_TO_MODEL=model_decides
